{
  "name": "native-audio-capture",
  "version": "1.0.0",
  "description": "Native C++ audio capture for Electron — WASAPI / CoreAudio / PipeWire + Opus encoding",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/detect_opus.js",
    "install": "node-gyp rebuild",
    "build": "node scripts/detect_opus.js && node-gyp rebuild",
    "build:debug": "node scripts/detect_opus.js && node-gyp rebuild --debug",
    "clean": "node-gyp clean && node -e \"try{require('fs').unlinkSync('config.gypi')}catch(_){}\"",
    "rebuild": "npm run clean && npm run build"
  },
  "dependencies": {
    "node-addon-api": "^8.3.0"
  },
  "gypfile": true
}
