{
  "name": "webrtc-desktop",
  "version": "1.0.0",
  "description": "WebRTC desktop client for Windows, Linux and macOS",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p electron/tsconfig.json && tsc && vite build && electron-builder",
    "electron:dev": "tsc -p electron/tsconfig.json && concurrently \"vite\" \"wait-on http://localhost:5177 && electron .\"",
    "build:win": "tsc -p electron/tsconfig.json && tsc && vite build && electron-builder --win",
    "build:mac": "tsc -p electron/tsconfig.json && tsc && vite build && electron-builder --mac",
    "build:linux": "tsc -p electron/tsconfig.json && tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "electron:build": "tsc -p electron/tsconfig.json && vite build && electron-builder"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "~5.6.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.webrtc.desktop",
    "productName": "WebRTC Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.video-conferencing"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon-512.png"
    }
  }
}
