{
  "name": "webrtc-desktop",
  "version": "1.0.0",
  "description": "WebRTC desktop client for Windows, Linux and macOS",
  "main": "dist-electron/main.js",
  "author": "",
  "license": "ISC",
  "scripts": {
    "dev": "vite",
    "native:build": "cd native-audio-capture && npm install",
    "build": "npm run native:build && tsc -p electron/tsconfig.json && tsc && vite build && electron-builder",
    "electron:dev": "npm run native:build && tsc -p electron/tsconfig.json && concurrently \"vite\" \"wait-on http://localhost:5177 && electron .\"",
    "build:win": "npm run native:build && tsc -p electron/tsconfig.json && tsc && vite build && electron-builder --win",
    "build:mac": "npm run native:build && tsc -p electron/tsconfig.json && tsc && vite build && electron-builder --mac",
    "build:linux": "npm run native:build && tsc -p electron/tsconfig.json && tsc && vite build && electron-builder --linux",
    "preview": "vite preview",
    "electron:build": "npm run native:build && tsc -p electron/tsconfig.json && vite build && electron-builder"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.1",
    "@fortawesome/free-brands-svg-icons": "^7.0.1",
    "@fortawesome/free-regular-svg-icons": "^7.0.1",
    "@fortawesome/free-solid-svg-icons": "^7.0.1",
    "@fortawesome/vue-fontawesome": "^3.1.2",
    "@tailwindcss/vite": "^4.1.13",
    "click-outside-vue3": "^4.0.1",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.13",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.16.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.31.0",
    "eslint-plugin-vue": "~10.3.0",
    "jiti": "^2.4.2",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.4.49",
    "prettier": "3.6.2",
    "typescript": "~5.8.0",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue-tsc": "^3.0.4",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.webrtc.desktop",
    "productName": "WebRTC Client",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "native-audio-capture/index.js",
      "native-audio-capture/package.json",
      "native-audio-capture/build/Release/stream_audio.node"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon-512.png",
      "category": "public.app-category.video-conferencing"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon-512.png"
    }
  }
}
